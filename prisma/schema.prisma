generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

enum DepreciationMethod {
  STRAIGHT_LINE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
}

model Department {
  id               String    @id @default(cuid())
  name             String    @unique
  code             String    @unique
  defaultActivity   Activity? @relation(fields: [defaultActivityId], references: [id])
  defaultActivityId String?
  assets           Asset[]
  createdAt        DateTime  @default(now())
}

model Activity {
  id          String       @id @default(cuid())
  function    String
  activity    String
  departments Department[]
  assets      Asset[]
  createdAt   DateTime     @default(now())

  @@unique([function, activity])
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  assets    Asset[]
  createdAt DateTime @default(now())
}

model AssetCategory {
  id                     String   @id @default(cuid())
  name                   String   @unique
  defaultUsefulLifeMonths Int
  isDepreciable          Boolean  @default(true)
  /// Minimum original cost to capitalize an asset in this category, per the
  /// county's Capital Asset Policy. Null means no threshold (e.g. Land and
  /// Buildings are "Capitalize All").
  capitalizationThreshold Decimal? @db.Decimal(14, 2)
  assets                 Asset[]
  createdAt              DateTime @default(now())
}

model Asset {
  id                 String              @id @default(cuid())
  assetTag           String              @unique
  name               String
  description        String?
  category            AssetCategory       @relation(fields: [categoryId], references: [id])
  categoryId          String
  department          Department          @relation(fields: [departmentId], references: [id])
  departmentId        String
  location            Location            @relation(fields: [locationId], references: [id])
  locationId          String
  purchaseDate         DateTime
  inServiceDate         DateTime
  originalCost         Decimal             @db.Decimal(14, 2)
  salvageValue         Decimal             @default(0) @db.Decimal(14, 2)
  usefulLifeMonths      Int
  depreciationMethod    DepreciationMethod  @default(STRAIGHT_LINE)
  openingAccumulatedDepreciation Decimal?   @db.Decimal(14, 2)
  openingAsOfDate      DateTime?
  activity             Activity?           @relation(fields: [activityId], references: [id])
  activityId           String?
  /// A later capitalized addition to this asset (e.g. an FY19 HVAC replacement on an
  /// existing building) links here rather than being merged into the original's cost,
  /// preserving the dated per-addition history GASB's Schedule of Changes in Capital
  /// Assets needs. Capped at one level: an addition cannot itself have additions.
  parentAsset          Asset?              @relation("AssetAdditions", fields: [parentAssetId], references: [id])
  parentAssetId        String?
  additions            Asset[]             @relation("AssetAdditions")
  depreciationEntries    DepreciationEntry[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([categoryId])
  @@index([departmentId])
  @@index([locationId])
  @@index([activityId])
  @@index([parentAssetId])
}

model DepreciationEntry {
  id                     String   @id @default(cuid())
  asset                  Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId                String
  periodDate             DateTime
  depreciationAmount     Decimal  @db.Decimal(14, 2)
  accumulatedDepreciation Decimal  @db.Decimal(14, 2)
  bookValue              Decimal  @db.Decimal(14, 2)
  isOpeningBalance       Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@unique([assetId, periodDate])
  @@index([periodDate])
}
